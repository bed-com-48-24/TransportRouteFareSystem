{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start frontend development server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build frontend after conflict repair",
