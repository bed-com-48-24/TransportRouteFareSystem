{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start frontend development server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Lint transport booking route",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"lint",
				"--",
				"app/transport-booking/page.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Lint booking page directly",
			"type": "shell",
			"command": "node",
			"args": [
				"frontend/node_modules/eslint/bin/eslint.js",
				"frontend/app/transport-booking/page.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Lint booking route with config",
			"type": "shell",
			"command": "node",
			"args": [
				"frontend/node_modules/eslint/bin/eslint.js",
				"--config",
				"frontend/eslint.config.mjs",
				"frontend/app/transport-booking/page.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Lint transport booking page",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"lint",
				"--",
				"app/transport-booking/page.tsx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build frontend after route fix",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install merged frontend dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}