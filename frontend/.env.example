# ---------------------------------------------------------------------------
# Backend (YendaRoute API)
# ---------------------------------------------------------------------------

# Server-side origin of the backend. Used by the Next.js rewrites in
# next.config.ts and by the service modules when they run on the server.
BACKEND_API_URL=http://localhost:3001

# Path prefix most backend controllers are mounted under.
BACKEND_API_PREFIX=/api/v1

# Direct API base and Swagger UI (documentation, server-side calls, Postman).
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SWAGGER_URL=http://localhost:3001/docs

# Same-origin proxy paths the browser calls. The backend does not send CORS
# headers, so browser requests are rewritten by Next.js to the backend.
NEXT_PUBLIC_API_PROXY_PATH=/backend-api
NEXT_PUBLIC_API_ROOT_PROXY_PATH=/backend-root
